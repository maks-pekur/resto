# Local development environment.
# Copy this file to `.env` and adjust as needed.
# Real production secrets live in Vault / 1Password Connect — never here.

# ---------- Postgres (application database) ----------
# Two roles per database, per RES-83:
#   POSTGRES_USER / DATABASE_ADMIN_URL — schema owner; runs migrations only.
#   resto_app    / DATABASE_URL        — runtime; NOSUPERUSER NOBYPASSRLS.
# The dev stack provisions resto_app from infra/docker/postgres/init/.
POSTGRES_USER=resto
POSTGRES_PASSWORD=resto_dev_password
POSTGRES_DB=resto
POSTGRES_PORT=5432
DATABASE_ADMIN_URL=postgres://resto:resto_dev_password@localhost:5432/resto
DATABASE_URL=postgres://resto_app:resto_app_dev_password@localhost:5432/resto

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------- NATS JetStream ----------
NATS_PORT=4222
NATS_HTTP_PORT=8222
NATS_URL=nats://localhost:4222
NATS_STREAM=RESTO_EVENTS

# ---------- Internal API auth ----------
# Shared secret guarding `/internal/v1/*` until the admin UI lands in
# MVP-2 (see ADR-0012). The seed CLI must use the same value.
INTERNAL_API_TOKEN=internal_dev_token_change_me

# ---------- Better Auth (identity, MVP-2 — ADR-0013) ----------
# All four required outside NODE_ENV=development; rotate per environment
# via Vault / 1Password Connect in staging and prod.
#
# 32+ char secret used to sign session cookies and tokens. Generate with
# `openssl rand -base64 48` for staging/prod.
BETTER_AUTH_SECRET=local_dev_secret_replace_me_with_a_real_32_char_value
# Public base URL of the api (cookie scope + email-link generation).
BETTER_AUTH_BASE_URL=http://localhost:3000
# Connection string for BA's drizzle client. Connects under `resto_auth`
# (BYPASSRLS) — distinct from DATABASE_URL (`resto_app` NOBYPASSRLS).
# Seeded by infra/docker/postgres/init/ alongside the resto_app role.
BETTER_AUTH_DATABASE_URL=postgres://resto_auth:auth_password_dev@localhost:5432/resto
# Cookie domain. Leave unset in dev so cookies bind host-only; set to
# `.resto.app` in production for cross-subdomain session sharing
# (admin.resto.app ↔ api.resto.app).
# AUTH_COOKIE_DOMAIN=
# Public URL of the admin web app — used as link target in invitation
# and password-reset emails.
ADMIN_WEB_URL=http://localhost:3001

# ---------- MinIO (S3-compatible object storage) ----------
# `S3_ENDPOINT`, `S3_ACCESS_KEY`, `S3_SECRET_KEY` are required outside
# NODE_ENV=development/test (ADR-0020 I-3). The values below are the
# local docker-compose MinIO credentials; production deploys inject
# per-bucket IAM credentials from Vault / 1Password Connect.
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=resto-dev
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_dev_password

# ---------- MailHog (SMTP catcher) ----------
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
# MailHog SMTP target for the dev email adapter (D-01). Defaults match
# the schema and `infra/docker/docker-compose.dev.yml` so dev boots
# without explicit env-seed.
MAILHOG_HOST=localhost
MAILHOG_PORT=1025

# ---------- Email transport (Resend — D-01, Phase 3) ----------
# Optional in dev/test (the factory picks MailHog/Captured by NODE_ENV);
# REQUIRED in staging/production via `assertProdGuardrails`. The dummy
# literal below is also rejected by the guardrail so it cannot
# accidentally ship — real key injected at runtime via Vault / 1Password
# Connect / cloud secret manager.
RESEND_API_KEY=re_test_dummy_for_ci_do_not_use_in_prod
# Verified Resend sender. Configure DNS (SPF + DKIM + DMARC) on resto.app
# at Cloudflare before deploying to staging (D-07).
RESEND_FROM=RestOS <noreply@resto.app>
# Reply-To header on platform emails (operator-facing).
RESEND_REPLY_TO=support@resto.app

# ---------- Jaeger / OpenTelemetry ----------
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=resto-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
OTEL_DISABLED=false

# ---------- Security middleware (RES-99) ----------
# CORS allowlist. Comma-separated patterns; each is either an exact
# origin or contains `*` as a single subdomain segment, e.g.:
#   https://admin.resto.app,https://*.menu.resto.app
# Empty list disables cross-origin requests entirely.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3003
# Per-IP rate limits, in requests per minute.
RATE_LIMIT_PUBLIC_PER_MIN=60
RATE_LIMIT_INTERNAL_PER_MIN=10
# Stricter per-IP limits for the three high-risk auth endpoints (RES-137).
# Values shown match the schema defaults; tighten in prod via Vault.
RATE_LIMIT_AUTH_SIGNUP_PER_MIN=5
RATE_LIMIT_AUTH_RESET_PER_MIN=5
RATE_LIMIT_AUTH_SIGNIN_PER_MIN=10
# Per-tenant signin cap (D-20). Layered on top of per-IP and per-email.
RATE_LIMIT_AUTH_SIGNIN_PER_TENANT_PER_MIN=60

# Password length policy enforced by BA's emailAndPassword config (RES-137).
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128

# Salt for audit_log PII anonymisation on tenant erasure (RES-138).
# Required outside dev/test; >=32 chars; immutable post-deploy.
AUDIT_ERASURE_SALT=local-dev-erasure-salt-replace-me-with-a-real-32-char-value

# ---------- Application ----------
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=3000
ADMIN_PORT=3001
WEBSITE_PORT=3002
QR_MENU_PORT=3003
LANDING_PORT=3004
