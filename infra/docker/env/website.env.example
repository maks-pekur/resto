# Rendered onto the box via infra/scripts/render-env.sh.
#
# NEXT_PUBLIC_* vars (NEXT_PUBLIC_API_ORIGIN, NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY)
# are baked into the client bundle at `docker build` time (plan 09's CI build
# args) — Next.js replaces those references statically at compile time, so
# they are not re-read from this file at container start. Only the
# server-runtime vars website's own code reads via process.env belong here.

NODE_ENV=production
DEPLOYMENT_ENVIRONMENT=production

# Server-side counterpart of the same build-time value (lib/env.ts runs in
# server components / route handlers, which do read process.env at runtime).
NEXT_PUBLIC_API_ORIGIN=https://api.${PUBLIC_APEX_DOMAIN}
WEBSITE_URL=https://${PUBLIC_APEX_DOMAIN}

# Optional — observability, not a correctness gate. A no-op when absent.
SENTRY_DSN=
