# Rendered onto the box via infra/scripts/render-env.sh (source
# compose.env's real values into the shell first — `${POSTGRES_DB}` and the
# NATS credentials below are cross-references, not independently filled
# in). Secrets are obvious CHANGE_ME_* tokens; gitleaks scans this repo.

NODE_ENV=production
API_PORT=3000
OTEL_DISABLED=true

DATABASE_URL=postgresql://resto_app:CHANGE_ME_APP_ROLE_PASSWORD@postgres:5432/${POSTGRES_DB}
# D-05: the outbox dispatcher's advisory lock needs a session-pinned
# connection. This box runs Postgres directly with no PgBouncer/pooler in
# front of it, so the direct connection is the same string as DATABASE_URL
# — that is permitted, not a shortcut.
DATABASE_DIRECT_URL=postgresql://resto_app:CHANGE_ME_APP_ROLE_PASSWORD@postgres:5432/${POSTGRES_DB}
BETTER_AUTH_DATABASE_URL=postgresql://resto_auth:CHANGE_ME_AUTH_ROLE_PASSWORD@postgres:5432/${POSTGRES_DB}
# DATABASE_ADMIN_URL is deliberately absent here. It crosses the
# CI/operator -> production database trust boundary and must not persist
# on the box — it is injected per invocation into the profile-gated
# `migrate` service only (see docker-compose.prod.yml).

BETTER_AUTH_SECRET=CHANGE_ME_BETTER_AUTH_SECRET_32_CHARS_MIN
BETTER_AUTH_BASE_URL=https://api.${PUBLIC_APEX_DOMAIN}
AUDIT_ERASURE_SALT=CHANGE_ME_AUDIT_ERASURE_SALT_32_CHARS_MIN
INTERNAL_API_TOKEN=CHANGE_ME_INTERNAL_API_TOKEN_16_CHARS_MIN

NATS_URL=nats://nats:4222
NATS_USERNAME=${NATS_USERNAME}
NATS_PASSWORD=${NATS_PASSWORD}

S3_ENDPOINT=CHANGE_ME_S3_ENDPOINT
S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
S3_REGION=CHANGE_ME_S3_REGION
S3_BUCKET=CHANGE_ME_S3_BUCKET
# Adjust once the R2 bucket's custom domain (or public bucket URL) is
# known — this is a plausible default, not necessarily the final value.
MEDIA_PUBLIC_BASE_URL=https://media.${PUBLIC_APEX_DOMAIN}

# Optional — observability, not a correctness gate. A no-op when absent.
SENTRY_DSN=

RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY
# The two env.schema.ts defaults that would otherwise always populate with
# an apex the founder may not own (`noreply@resto.app` / `support@resto.app`)
# — every operator invitation, password reset and email verification is
# rejected by Resend on any other apex. The boot guard that makes a
# forgotten override fail closed is plan 07 Task 3's work.
RESEND_FROM="RestOS <noreply@${PUBLIC_APEX_DOMAIN}>"
RESEND_REPLY_TO=support@${PUBLIC_APEX_DOMAIN}

STRIPE_SECRET_KEY=CHANGE_ME_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=CHANGE_ME_STRIPE_WEBHOOK_SECRET
STRIPE_CONNECT_CLIENT_ID=CHANGE_ME_STRIPE_CONNECT_CLIENT_ID
STRIPE_CONNECT_RETURN_URL=https://${ADMIN_APEX_DOMAIN}/stripe/return
STRIPE_CONNECT_REFRESH_URL=https://${ADMIN_APEX_DOMAIN}/stripe/refresh

# Compose bridge range PLUS Cloudflare's published edge ranges
# (cloudflare.com/ips, fetched 2026-09-05) — bridge alone stops
# `parseTrustProxy`'s right-to-left walk at the Cloudflare PoP, turning
# every anonymous/credential rate limit into a per-PoP limit
# (security.ts:66-74 keys on ip:${req.ip}). Widening is safe for tenant
# resolution: tenant-context.middleware.ts only checks TRUST_PROXY.length
# > 0, a boolean, never the CIDRs themselves.
TRUST_PROXY=172.16.0.0/12,173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32

AUTH_COOKIE_DOMAIN=.${ADMIN_APEX_DOMAIN}
ADMIN_WEB_URL=https://${ADMIN_APEX_DOMAIN}
ADMIN_WEB_ORIGIN_WILDCARD=https://*.${ADMIN_APEX_DOMAIN}
WEBSITE_PUBLIC_URL=https://${PUBLIC_APEX_DOMAIN}
PUBLIC_APEX_DOMAIN=${PUBLIC_APEX_DOMAIN}
GUEST_APEX_DOMAIN=${GUEST_APEX_DOMAIN}

# Website's client-side checkout genuinely calls the API cross-origin.
# Admin and qr-menu reach the API same-origin through their own Workers —
# adding their hosts here re-opens the cross-origin path phase 10.2 D-39
# closed after F-41. Do not add ADMIN_APEX_DOMAIN / GUEST_APEX_DOMAIN.
CORS_ALLOWED_ORIGINS=https://${PUBLIC_APEX_DOMAIN},https://*.${PUBLIC_APEX_DOMAIN}
