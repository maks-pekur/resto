# Read by docker-compose.prod.yml itself (via --env-file / project .env).
# Copy to /opt/resto/.env on the box, fill in real values. Never committed
# with real values — gitleaks scans this repo, so placeholders here are
# obvious CHANGE_ME_* tokens, never realistic-looking key material.

PUBLIC_APEX_DOMAIN=CHANGE_ME_PUBLIC_APEX_DOMAIN
ADMIN_APEX_DOMAIN=CHANGE_ME_ADMIN_APEX_DOMAIN
GUEST_APEX_DOMAIN=CHANGE_ME_GUEST_APEX_DOMAIN

GHCR_OWNER=CHANGE_ME_GHCR_OWNER
API_IMAGE_TAG=CHANGE_ME_API_IMAGE_TAG
WEBSITE_IMAGE_TAG=CHANGE_ME_WEBSITE_IMAGE_TAG

# Only the main apex reaches Caddy — the admin and guest zones terminate at
# their Cloudflare Workers and never touch this origin. All three apexes
# are still declared here because render-env.sh expands them into
# .env.api, and because a reader needs the whole map in one place.
API_HOST=api.${PUBLIC_APEX_DOMAIN}
WEBSITE_HOST=${PUBLIC_APEX_DOMAIN}

# TEST-NET-1 (RFC 5737) by default — matches nothing, so a missing override
# fails closed on the Caddyfile's /internal* gate instead of admitting every
# client. Real value is Cloudflare's own edge ranges once ufw is in place.
INTERNAL_ALLOWED_IPS=192.0.2.1/32

POSTGRES_ADMIN_USER=CHANGE_ME_POSTGRES_ADMIN_USER
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_POSTGRES_ADMIN_PASSWORD
POSTGRES_DB=CHANGE_ME_POSTGRES_DB

NATS_USERNAME=CHANGE_ME_NATS_USERNAME
NATS_PASSWORD=CHANGE_ME_NATS_PASSWORD
