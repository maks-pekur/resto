pnpm lint-staged

# Affected typecheck — keeps type regressions from sliding past local
# commits. `--uncommitted` compares the working tree (staged + unstaged)
# against HEAD, so we only typecheck projects whose source actually
# changed. Fast on small commits, no false positives on rebases.
#
# Spine migrations (a rename that crosses packages/domain or packages/db
# and cannot leave the repo type-green until every call site is fixed)
# opt out with RESTO_SPINE_MIGRATION=1. lint-staged above still runs, so
# formatting and lint are never bypassed. The phase that sets it owes a
# green gate before it closes.
if [ "${RESTO_SPINE_MIGRATION:-}" = "1" ]; then
  echo "⚠ RESTO_SPINE_MIGRATION=1 — affected typecheck skipped for this commit"
else
  pnpm exec nx affected -t typecheck --uncommitted --parallel=3
fi
