{
  "extends": "@resto/config-typescript/vite.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "types": ["vite/client", "node"],
    "paths": {
      "@resto/api-client": ["../../packages/api-client/src/index.ts"],
      "@resto/api-client/public": ["../../packages/api-client/src/public.ts"],
      "@resto/api-client/internal": ["../../packages/api-client/src/internal.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    "eslint.config.mjs"
  ],
  "exclude": ["node_modules", "dist"]
}
