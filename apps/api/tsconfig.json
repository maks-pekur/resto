{
  "extends": "@resto/config-typescript/node.json",
  "compilerOptions": {
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "eslint.config.mjs",
    "../../packages/db/src/sql.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
