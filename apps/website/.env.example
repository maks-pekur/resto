# apps/website local development environment.
# Copy to `apps/website/.env.local` and adjust. Production secrets live in
# Vault / 1Password Connect — never commit real values.
#
# Both vars are required outside NODE_ENV=development|test; missing
# values crash the process at boot via `lib/env.ts`.

# Public origin of the api (Next.js bakes NEXT_PUBLIC_* into the client
# bundle at build time; safe to expose).
NEXT_PUBLIC_API_ORIGIN=http://localhost:3000

# Public URL of the website. Used for canonical URLs and redirects.
WEBSITE_URL=http://localhost:3002
