{
  "extends": "@resto/config-typescript/vite.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@resto/api-client": ["../../packages/api-client/src/index.ts"]
    },
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "vite.config.ts",
    "vitest.config.ts",
    "eslint.config.mjs"
  ],
  "exclude": ["node_modules", "dist"]
}
