# apps/admin local development environment.
# Copy to `apps/admin/.env.local` and adjust. Production secrets live in
# Vault / 1Password Connect — never commit real values.
#
# All four vars are required outside NODE_ENV=development|test; missing
# values crash the process at boot via `lib/env.ts` + `instrumentation.ts`
# (apps/CLAUDE.md env-var rule; CONTEXT D-05, D-06).

# There is no VITE_API_ORIGIN. The admin app calls the api via same-origin
# relative paths (/v1/*, /api/*) so the operator session cookie — scoped to
# AUTH_COOKIE_DOMAIN=.admin.resto.app in production — stays first-party;
# an absolute cross-host URL gets its Set-Cookie silently dropped by
# third-party-cookie blocking (Chrome, and Safari/Firefox by default for
# years). Dev: vite.config.ts proxies /api and /v1 to localhost:5001.
# Production: the admin host's reverse proxy/CDN must forward /v1/* and
# /api/* to the api (10.2-17-SUMMARY.md has the full requirement).

# Hostname suffix organization hosts are built against (D-21). No scheme,
# no port: <slug>.<this> is the pattern `parseOrgSlugFromHost` matches
# against `window.location.hostname` and `adminUrlForOrg` builds URLs
# from. Dev default (admin.localhost) is baked into `getEnv`'s
# `devDefaults`; only set this when running against a non-default host.
# Production: VITE_ADMIN_HOST_SUFFIX=admin.resto.app
# VITE_ADMIN_HOST_SUFFIX=admin.localhost

# Public origin of the admin web app. Forwarded as `Origin` header on
# server-side fetches so BA's trusted-origin guard passes (RES-113).
ADMIN_WEB_URL=http://localhost:4000

# Shared secret guarding `/internal/v1/*` routes. Server-only — must
# match `INTERNAL_API_TOKEN` configured for `apps/api`.
INTERNAL_API_TOKEN=internal_dev_token_change_me

# HMAC secret for signing the `resto.active_brand` cookie. >=32 chars.
# Distinct from BETTER_AUTH_SECRET — separating secrets prevents key
# rotation coupling and bounds blast radius (CONTEXT D-03). Generate
# staging/prod values with `openssl rand -base64 48`.
ACTIVE_BRAND_COOKIE_SECRET=dev-only-active-brand-secret-replace-with-32+chars
