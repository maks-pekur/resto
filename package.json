{
  "name": "resto",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant SaaS platform for restaurants — admin, website, QR-menu.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.22.1",
    "pnpm": "~9.15.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint --fix",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:e2e": "nx run-many -t e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi:check": "tsx tools/openapi-check.ts",
    "dev:up": "docker compose -f infra/docker/docker-compose.dev.yml up -d",
    "dev:down": "docker compose -f infra/docker/docker-compose.dev.yml down",
    "dev:logs": "docker compose -f infra/docker/docker-compose.dev.yml logs -f",
    "dev:reset": "docker compose -f infra/docker/docker-compose.dev.yml down -v",
    "dev:cert": "bash tools/scripts/dev-cert.sh",
    "test:stack:up": "node scripts/test-stack.mjs up",
    "test:stack:down": "node scripts/test-stack.mjs down",
    "test:stack:status": "node scripts/test-stack.mjs status",
    "test:stack:smoke": "node scripts/test-stack-smoke.mjs",
    "resto:seed": "tsx tools/scripts/seed/cli.ts",
    "resto:erase-tenant": "tsx --tsconfig apps/api/tsconfig.json tools/scripts/erase-tenant/cli.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@nx/eslint-plugin": "22.7.9",
    "@types/node": "^25.9.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "nx": "22.7.9",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "lodash": "^4.18.1",
      "minimatch": "^9.0.7",
      "@babel/plugin-transform-modules-systemjs": "^7.29.4",
      "fast-xml-builder": "^1.1.7",
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "nanoid": "^3.3.18",
      "postcss": "^8.5.23",
      "ws": "^8.21.0",
      "js-yaml": "^4.3.1",
      "protobufjs": "^7.6.5",
      "form-data": "^4.0.6",
      "axios": "^1.18.0",
      "tmp": "^0.2.6",
      "shell-quote": "^1.9.0",
      "@grpc/grpc-js": "^1.14.4",
      "@babel/core": "^7.29.6",
      "kysely": "^0.28.17",
      "sharp": "^0.35.0",
      "brace-expansion@2": "^2.1.3",
      "brace-expansion@5": "^5.0.9",
      "fast-uri@2": "^2.4.4",
      "fast-uri@3": "^3.1.5",
      "nx": "^22.7.7",
      "esbuild@0.18": "^0.25.12",
      "esbuild@0.21": "^0.25.12",
      "yaml@2": "^2.8.3",
      "uuid@11": "^11.1.1",
      "esbuild@0.27": "^0.28.1"
    }
  }
}
